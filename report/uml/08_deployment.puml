@startuml 08_deployment
!pragma layout smetana
title GradPath AI - Deployment Diagram (runs locally, Neon as the only database)
skinparam node {
  BackgroundColor #EEF2FF
  BorderColor #6366F1
}

node "Local PC (Windows, lab or student laptop)" as pc {
  artifact "Web browser\n(HTML, CSS, JS from frontend/)" as br
  node "JVM 21 (Eclipse Temurin)" as jvm {
    artifact "gradpath-ai.jar\n(Spring Boot, Tomcat, Thymeleaf)\nbuilt from backend/ + frontend/" as jar
    artifact "ml/placement-model.json\n(bundled in the jar)" as model
  }
  artifact ".env (git-ignored)\nDATABASE_URL, TEST_DATABASE_URL,\nOFFICER_ACCESS_CODE, GROQ_API_KEY ..." as env
  artifact "train-model command\n+ placement.csv (optional)" as trainer
}
node "cdnjs.cloudflare.com / Google Fonts" as cdn {
  artifact "plotly.min.js 2.35.3 (SRI)" as plotly
  artifact "Inter font" as font
}
node "Neon (serverless PostgreSQL 18)" as neon {
  database "main branch: neondb\n(users, students, jobs,\napplications, messages, ...)" as db
  database "test branch\n(integration tests only,\nevery test rolled back)" as testdb
}
node "AI provider (optional)\napi.groq.com" as groq

br --> jar : HTTP localhost:8080
br --> cdn : HTTPS
jar --> db : JDBC over TLS (sslmode=require)
jar --> groq : HTTPS (anonymous context)
jar ..> env : reads at start-up
jar ..> model : loads once at start-up
trainer ..> model : writes new model
@enduml
