# Copy to .env and fill in the values (.env is git-ignored). Real environment variables override this file.

# Neon PostgreSQL connection string (libpq form, as shown in the Neon console) or a jdbc:postgresql:// URL.
# Required - the app uses Neon as its only database.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require

# Separate Neon branch used ONLY by the integration tests (Neon console: Branches -> Create branch "test").
# Leave empty to skip the database tests. The app itself never reads this value.
TEST_DATABASE_URL=

# Private code Career Officers must enter to register. Empty = officer registration is disabled.
OFFICER_ACCESS_CODE=

# Demo accounts and fictional demo records (for demonstrations only).
ENABLE_DEMO_LOGIN=false
SEED_DEMO_DATA=false

# Default CGPA grading scale offered to students (4.0, 5.0 or 10.0).
CGPA_SCALE=4.0

# Send the sign-in cookie only over HTTPS. Keep false for http://localhost.
COOKIE_SECURE=false

# Career assistant: rule (built-in, no key needed) | groq | openai | gemini | anthropic
CHATBOT_PROVIDER=rule
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: placement model file produced by "java -jar target/gradpath-ai.jar train-model <csv>".
# Empty = use the model bundled in the application.
PLACEMENT_MODEL_PATH=
